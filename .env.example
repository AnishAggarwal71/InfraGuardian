# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Leave both unset to run entirely offline against the free FakeInfraGuardianModel.
# Set INFRAGUARDIAN_MODEL to a "provider:model" string LangChain's init_chat_model understands,
# and set that provider's own API key env var (read natively by the provider SDK, not by this
# project's code).
INFRAGUARDIAN_MODEL=
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
